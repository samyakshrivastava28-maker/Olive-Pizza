# ==============================================================================
# Olive Pizza Client Application - Example Environment Variables (No Secrets)
# ==============================================================================

# Backend API Resolution
VITE_API_BASE_URL=https://olivepizza-owner.onrender.com
VITE_BACKEND_URL=https://olivepizza-owner.onrender.com

# Firebase Client Configuration (Standard Public App Credentials)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Supabase Realtime Telemetry Client
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Authentication Environment Mode (development | production)
VITE_PHONE_AUTH_MODE=development

# Cloudflare Turnstile Bot Protection (Site Key)
VITE_TURNSTILE_SITE_KEY=

# Version Tagging
VITE_APP_VERSION=1.0.0
