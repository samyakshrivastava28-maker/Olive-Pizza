rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    function isAppOwner() {
      return request.auth != null && request.auth.token.role == 'owner';
    }

    function hasFullAccess() {
      return isAdmin() || isAppOwner();
    }

    function isDeliveryPartner() {
      return request.auth != null && request.auth.token.role == 'delivery_partner';
    }

    // --- PROTECTED BUSINESS COLLECTIONS (NO FRONTEND WRITES ALLOWED) ---
    // All writes must go through the backend API.
    
    match /users/{userId} {
      allow read: if isOwner(userId) || hasFullAccess();
      allow write: if false;
    }

    match /orders/{orderId} {
      allow read: if hasFullAccess() || 
                  (isSignedIn() && resource.data.userId == request.auth.uid) || 
                  (isDeliveryPartner() && (resource.data.deliveryPartnerId == request.auth.uid || resource.data.status in ['ready', 'packed', 'partner_assigned', 'picked_up', 'out_for_delivery']));
      allow write: if false;
    }

    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    match /menu_categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /combos/{comboId} {
      allow read: if true;
      allow write: if false;
    }

    match /offers/{offerId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /delivery_zones/{zoneId} {
      allow read: if true;
      allow write: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if false;
    }

    // --- PERMITTED CLIENT WRITES ---
    // Only non-business operational data can be written directly by the frontend.

    match /device_heartbeats/{sessionId} {
      allow read: if hasFullAccess() || isOwner(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid);
      allow update: if isOwner(resource.data.uid);
      allow delete: if hasFullAccess();
    }
    
    match /user_carts/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    match /client_errors/{errorId} {
      allow create: if true;
      allow read, update, delete: if hasFullAccess();
    }
    
    match /activity_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if hasFullAccess();
    }
    
    match /crash_reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if hasFullAccess();
    }

    match /home_layout/{document=**} {
      allow read: if true;
      allow write: if hasFullAccess();
    }
    
    match /home_layout_versions/{versionId} {
      allow read, write: if hasFullAccess();
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
