{
  "appId": "com.olivepizza.app",
  "appName": "Olive Pizza",
  "webDir": "dist/client",
  "server": {
    "url": "https://olive-pizza.vercel.app",
    "cleartext": true,
    "allowNavigation": ["olive-pizza.vercel.app", "*.firebaseapp.com", "*.googleapis.com"]
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#0B0F14",
    "overrideUserAgent": "Mozilla/5.0 (Linux; Android 13; SM-S918B) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/112.0.0.0 Mobile Safari/537.36"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0
    }
  }
}
