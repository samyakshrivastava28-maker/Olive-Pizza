{
	"appId": "com.olivepizza.app",
	"appName": "Olive Pizza",
	"webDir": "dist/client",
	"server": {
		"androidScheme": "https",
		"iosScheme": "https",
		"allowNavigation": [
			"*.olivepizza.in",
			"*.firebaseapp.com",
			"*.googleapis.com",
			"*.gstatic.com",
			"*.google.com",
			"challenges.cloudflare.com",
			"*.onrender.com",
			"*.cloudinary.com",
			"res.cloudinary.com"
		]
	},
	"ios": {
		"contentInset": "always"
	},
	"android": {
		"allowMixedContent": true,
		"captureInput": true,
		"webContentsDebuggingEnabled": true,
		"backgroundColor": "#0B0F14"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 0
		},
		"FirebaseAuthentication": {
			"skipNativeAuth": false,
			"providers": [
				"google.com"
			],
			"googleClientId": "1017239455106-i8vrpdq1v51pkg0308k7btu1o4img597.apps.googleusercontent.com"
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		},
		"Geolocation": {
			"requestPermissions": true
		}
	}
}
