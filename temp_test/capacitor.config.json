{
  "appId": "com.olivepizza.app",
  "appName": "Olive Pizza",
  "webDir": "dist/client",
  "server": {
    "url": "https://olive-pizza.vercel.app",
    "cleartext": true,
    "allowNavigation": ["olive-pizza.vercel.app", "*.firebaseapp.com", "*.googleapis.com"]
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#0B0F14"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0
    }
  }
}
